DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/delivery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# console prints codes to the worker log, http sends them through SMS_GATEWAY_URL
SMS_BACKEND=console
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER=Delivery
